# Local overrides for the dashboard dev server (`npm run dev`).
# Copy to `.env` (git-ignored) and edit. A shell environment variable of the
# same name takes precedence over this file.

# Backend that the dev server proxies `/api` to. Default: http://localhost:18080
# e.g. point it at a test board instead of a local nvr:
# NVR_API_TARGET=http://192.168.1.50:18080
NVR_API_TARGET=http://localhost:18080
